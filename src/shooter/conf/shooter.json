  "set-ffc-temp-delta": {
    "definition": "Set FFC temperature delta in degrees Celsius",
    "command": "set_ffc_temp_delta",
    "params": {
      "value": {
        "definition": "Temperature change required to trigger FFC",
        "type": "float",
        "min": 0.0,
        "max": 10.0,
        "required": true
      }
    }
  },
  
  "get-ffc-integration-period": {
