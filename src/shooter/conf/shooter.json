{
  "averager-mode": {
    "definition": "Enable or disable smart frame averaging",
    "command": "averager_mode",
    "params": {
      "mode": {
        "definition": "Averager state",
        "type": "str",
        "choices": [
          "on",
          "off"
        ],
        "required": true
      }
    }
  },

  "get-frame-rate": {
    "definition": "Get video output frame rate in Hz",
    "command": "dvoGetLcdVideoFrameRate",
    "params": {}
  },

  "set-frame-rate": {
    "definition": "Set video output frame rate in Hz",
    "command": "dvoSetLcdVideoFrameRate",
    "params": {
      "framerate": {
        "definition": "Video frame rate in Hz",
        "type": "int",
        "choices": [30, 60],
        "required": true
      }
    }
  },

  "get-color": {
    "definition": "Get current color palette",
    "command": "colorLutGetId",
    "params": {}
  },

  "set-color": {
    "definition": "Set color palette",
    "command": "set_color",
    "params": {
      "color": {
        "definition": "Color palette",
        "type": "str",
        "choices": [
          "white-hot",
          "black-hot",
          "rainbow",
          "rainbow-hc",
          "ironbow",
          "lava",
          "arctic",
          "globow",
          "graded-fire",
          "hottest"
        ],
        "required": true
      }
    }
  },

  "get-agc-mode": {
    "definition": "Get current AGC mode",
    "command": "agcGetMode",
    "params": {}
  },

  "set-agc-mode": {
    "definition": "Set automatic gain control mode",
    "command": "set_agc_mode",
    "params": {
      "mode": {
        "definition": "AGC processing mode",
        "type": "str",
        "choices": [
          "normal",
          "hold",
          "threshold",
          "auto-bright",
          "auto-linear",
          "manual"
        ],
        "required": true
      }
    }
  },

  "get-agc-tail-rejection": {
